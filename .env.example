# Routing: "path" = one domain, every app in a subfolder (/owner, /pos, /kds …) — works on any preview URL.
#          "subdomain" = bornis.id, app., pos., kds., display., order., admin. (see `npm run check:deploy` for DNS).
NEXT_PUBLIC_BORNIZ_ROUTING=path
NEXT_PUBLIC_BORNIZ_ROOT_DOMAIN=bornis.id
NEXT_PUBLIC_BORNIZ_PROTOCOL=https
# Tenant used for links when a page has no tenant in its URL (demo / single-tenant installs).
NEXT_PUBLIC_BORNIZ_DEFAULT_TENANT=kopibiru
# Merchant domains → tenant, e.g. {"menu.kopibiru.id":"kopibiru"}. Production: load from the tenants table into Edge Config.
NEXT_PUBLIC_BORNIZ_CUSTOM_DOMAINS={}
# Each surface on its own hostname before the domain exists, e.g. {"pos":"pos-soft-ajie-pos.vercel.app"} (sets routing to subdomain).
# NEXT_PUBLIC_BORNIZ_HOSTS={}

# Own PostgreSQL. Empty = demo mode: data stays in the browser, attendance machines and gateways are off.
# `npm run db:migrate` installs / updates it (deploy/update.sh runs it); the app connects as DATABASE_URL's role.
DATABASE_URL=postgres://borniz_app:<password>@localhost:5432/borniz
# The database owner (create role … createrole, no superuser) that runs the migrations (deploy/update.sh shows the setup):
DATABASE_ADMIN_URL=postgres://borniz_owner:<password>@localhost:5432/borniz

# Server only: payments, webhooks and attendance machines. db:migrate writes it into the database (private.secrets 'server').
BORNIZ_SERVER_SECRET=
# Merchants moved to their own database (scripts/tenant-move.sh): where it is and its server secret.
# BORNIZ_DB_CELLS={"<cell>":"postgres://…"}
# BORNIZ_CELLS={"<cell>":"<that database's server secret>"}
# Password-reset mail (else the link is written to the server log):
# RESEND_API_KEY=
# BORNIZ_MAIL_FROM=BorNiz <no-reply@bornis.id>
# Days of history each device loads (default 35).
# NEXT_PUBLIC_BORNIZ_WINDOW_DAYS=35

# NEXT_PUBLIC_* values are baked in at build time: change them, then rebuild (deploy/update.sh).
