# Routing: "path" = one domain, every app in a subfolder (/owner, /pos, /kds …) — works on any preview URL.
#          "subdomain" = bornis.id, app., pos., kds., display., order., admin. (see `npm run check:deploy` for DNS).
NEXT_PUBLIC_BORNIZ_ROUTING=path
NEXT_PUBLIC_BORNIZ_ROOT_DOMAIN=bornis.id
NEXT_PUBLIC_BORNIZ_PROTOCOL=https
# Tenant used for links when a page has no tenant in its URL (demo / single-tenant installs).
NEXT_PUBLIC_BORNIZ_DEFAULT_TENANT=kopibiru
# Merchant domains → tenant, e.g. {"menu.kopibiru.id":"kopibiru"}. Production: load from the tenants table into Edge Config.
NEXT_PUBLIC_BORNIZ_CUSTOM_DOMAINS={}
